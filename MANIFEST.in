include include *.txt
include README.md
include dycco/resources/*
include Makefile
recursive-include docs *.jpg *.md *.txt *.css *.html *.js *.svg *.json
recursive-include src *.css
recursive-include src *.html
include *.lock
global-include *.py *.ptl
include docs/*.txt docs/*.css docs/*.html
prune _Notneeded
prune .python-version
